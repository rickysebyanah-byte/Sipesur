# Salin menjadi .env untuk development lokal.
# Di Vercel, isi nilai yang sama lewat Project Settings > Environment Variables.

# Rahasia penandatangan JWT. Buat string acak panjang, jangan pakai contoh ini.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=isi-dengan-api-key-supabase

# Opsional. Dasar tautan QR pada surat.
# Kosongkan di Vercel: domain produksi dipakai otomatis.
CLIENT_URL=http://localhost:5173
PORT=5000
